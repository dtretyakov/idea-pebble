<!-- Pebble's tools in the IDE's MCP server, for coding agents. Loaded only where the IDE has the server. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolset implementation="com.github.dtretyakov.pebble.agent.mcp.PebbleToolset"/>
    </extensions>
</idea-plugin>
