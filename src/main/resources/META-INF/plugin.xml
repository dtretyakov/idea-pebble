<idea-plugin>
    <vendor email="dtretyakov@gmail.com" url="https://github.com/dtretyakov/idea-pebble">Dmitry Tretyakov</vendor>

    <description><![CDATA[
        Build, run and deploy apps and watchfaces for Pebble smartwatches — in C or in Alloy
        (JavaScript and TypeScript) — in IntelliJ IDEA, CLion and WebStorm.
        <p>
        The plugin drives the official Pebble SDK and pebble-tool; it does not replace them.
        </p>
        <ul>
            <li>New projects, SDKs to install and activate, and a platform to work on beside the Run button.</li>
            <li>Build into the Build tool window, and run in the emulator — its screen, buttons and touch in the
                IDE — or on a watch, with the app's logs in the console.</li>
            <li>Debug Alloy in the IDE's debugger — breakpoints and conditions, stepping, the stack, variables and
                expressions — and C with gdb in the console.</li>
            <li>Each platform's memory after a build, and a word when an app exits with memory it never freed.</li>
            <li>Screenshots of every platform side by side, and GIFs of the emulator's screen.</li>
            <li>UI test scenarios run in the IDE's test runner, comparing each platform's screens with reference
                screenshots.</li>
            <li>Code insight from the IDE's own engines with the SDK's headers and typings, and checks for
                what the build would not catch: calls a target platform only stubs out, missing resources,
                unused message keys.</li>
        </ul>
        <h3>Getting started</h3>
        <ol>
            <li>Install pebble-tool: <code>uv tool install pebble-tool</code>.</li>
            <li><b>New Project | Pebble</b>, or open a folder whose <code>package.json</code> has a
                <code>pebble</code> section.</li>
            <li>If the SDK is missing, the editor says so and offers to install it.
                <b>Tools | Pebble | Check Environment</b> shows everything at once.</li>
            <li>Pick a platform beside the Run button and press Run.</li>
        </ol>
        <p>For C in IntelliJ IDEA or WebStorm, install the LSP4IJ plugin and clangd; CLion needs neither.</p>
    ]]></description>

    <!--
      The platform and nothing else. The same archive runs in IDEA, CLion and WebStorm because it is
      compiled against none of them; build.gradle.kts verifies all three.
    -->
    <depends>com.intellij.modules.platform</depends>
    <!--
      The IDE's test runner, for UI test scenarios: a core module in 2026.1, a bundled plugin's from
      2026.2. Only smRunner, which brings the test runner it is built on: 2026.1 does not offer
      intellij.platform.testRunner as a module to depend on.
    -->
    <dependencies>
        <module name="intellij.platform.smRunner"/>
    </dependencies>
    <!-- clangd for C outside CLion. Optional: CLion has its own C engine, and nothing else needs it. -->
    <depends optional="true" config-file="pebble-lsp4ij.xml">com.redhat.devtools.lsp4ij</depends>
    <!-- Completion and checks for package.json's pebble section. -->
    <depends optional="true" config-file="pebble-json.xml">com.intellij.modules.json</depends>
    <!-- Tools for coding agents, in the IDE's own MCP server. -->
    <depends optional="true" config-file="pebble-mcp.xml">com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Pebble" displayType="BALLOON"/>
        <projectConfigurable
            parentId="language"
            id="settings.pebble"
            displayName="Pebble"
            instance="com.github.dtretyakov.pebble.ui.PebbleConfigurable"/>
        <editorNotificationProvider
            implementation="com.github.dtretyakov.pebble.ui.MissingSdkNotification"/>

        <newProjectWizard.generator implementation="com.github.dtretyakov.pebble.ui.wizard.PebbleNewProjectWizard"/>
        <directoryProjectGenerator implementation="com.github.dtretyakov.pebble.ui.wizard.PebbleDirectoryProjectGenerator"/>

        <configurationType implementation="com.github.dtretyakov.pebble.run.PebbleRunConfigurationType"/>
        <runConfigurationProducer implementation="com.github.dtretyakov.pebble.run.PebbleRunConfigurationProducer"/>
        <programRunner implementation="com.github.dtretyakov.pebble.run.PebbleDebugRunner"/>
        <projectTaskRunner implementation="com.github.dtretyakov.pebble.build.PebbleProjectTaskRunner"/>
        <stepsBeforeRunProvider implementation="com.github.dtretyakov.pebble.run.PebbleBuildBeforeRunTaskProvider"/>
        <postStartupActivity implementation="com.github.dtretyakov.pebble.run.PebbleRunConfigurations"/>
        <postStartupActivity implementation="com.github.dtretyakov.pebble.project.CompileDatabase$Startup"/>
        <toolWindow
            id="Pebble Emulator"
            anchor="right"
            icon="/icons/pebble.svg"
            canCloseContents="false"
            doNotActivateOnStart="true"
            factoryClass="com.github.dtretyakov.pebble.emulator.EmulatorToolWindowFactory"/>
        <additionalLibraryRootsProvider implementation="com.github.dtretyakov.pebble.library.PebbleLibraryProvider"/>
        <!-- UI test scenarios: plain text files, run in the IDE's test runner. -->
        <fileType name="PLAIN_TEXT" extensions="pbtest"/>
        <configurationType implementation="com.github.dtretyakov.pebble.uitest.PebbleUiTestConfigurationType"/>
        <runConfigurationProducer implementation="com.github.dtretyakov.pebble.uitest.PebbleUiTestConfigurationProducer"/>
        <runLineMarkerContributor language="TEXT" implementationClass="com.github.dtretyakov.pebble.uitest.ScenarioRunLineMarker"/>
        <localInspection
            language="TEXT"
            shortName="PebbleUiScenario"
            displayName="Pebble UI test scenario"
            groupName="Pebble"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.github.dtretyakov.pebble.uitest.ScenarioInspection"/>
        <!-- The Alloy debugger's own line breakpoints, where the JavaScript debugger's are not installed. -->
        <xdebugger.breakpointType implementation="com.github.dtretyakov.pebble.debug.AlloyLineBreakpointType"/>
        <xdebugger.breakpointType implementation="com.github.dtretyakov.pebble.debug.AlloyExceptionBreakpointType"/>
        <xdebugger.breakpointType implementation="com.github.dtretyakov.pebble.debug.gdb.PebbleCLineBreakpointType"/>
        <advancedSetting id="pebble.debug.gdbConsole" default="false" bundle="messages.PebbleBundle" groupKey="advanced.settings.group.pebble"/>
        <!-- No language: a C file is CLion's language in CLion, TextMate's in IDEA, plain text elsewhere. -->
        <localInspection
            shortName="PebblePlatformStubCall"
            displayName="Call to a function the target platform stubs out"
            groupName="Pebble"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.github.dtretyakov.pebble.lang.PlatformStubCallInspection"/>
    </extensions>

    <applicationListeners>
        <listener
            class="com.github.dtretyakov.pebble.project.SdkChanges"
            topic="com.github.dtretyakov.pebble.project.PebbleSdkService$Listener"/>
    </applicationListeners>

    <projectListeners>
        <listener
            class="com.github.dtretyakov.pebble.project.CompileDatabase$Listener"
            topic="com.github.dtretyakov.pebble.project.PebbleSettings$Listener"/>
        <listener
            class="com.github.dtretyakov.pebble.project.CompileDatabase$Listener"
            topic="com.github.dtretyakov.pebble.build.PebbleBuild$Listener"/>
        <listener class="com.github.dtretyakov.pebble.agent.PebbleRunLogs$Listener"
            topic="com.intellij.execution.ExecutionListener"/>
        <listener
            class="com.github.dtretyakov.pebble.library.PebbleLibraryProvider$PlatformListener"
            topic="com.github.dtretyakov.pebble.project.PebbleSettings$Listener"/>
    </projectListeners>

    <actions>
        <action id="Pebble.AcceptScreenshot" class="com.github.dtretyakov.pebble.uitest.AcceptScreenshotAction">
            <add-to-group group-id="TestTreePopupMenu" anchor="last"/>
        </action>
        <!--
          The active platform, beside the run configuration in the run widget: the choice that the
          build, the compile database and the emulator all follow.
        -->
        <action
            id="Pebble.SelectPlatform"
            class="com.github.dtretyakov.pebble.ui.SelectPlatformAction"
            text="Pebble Platform"
            description="Chooses the platform Build, Run and code insight use">
            <add-to-group
                group-id="RunToolbarMainActionGroup"
                anchor="after"
                relative-to-action="RunToolbarTopLevelExecutorActionGroup"/>
        </action>
        <action
            id="Pebble.AddAgentSkill"
            class="com.github.dtretyakov.pebble.ui.AddAgentSkillAction"
            text="Add Pebble Skill for Agents"
            description="Writes the pebble Agent Skill into the project's .claude/skills, for coding agents">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="Pebble.Build"
            class="com.github.dtretyakov.pebble.ui.BuildAction"
            text="Build Pebble App"
            description="Builds the app for every platform it targets, with pebble build"
            icon="AllIcons.Actions.Compile">
            <add-to-group group-id="BuildMenu" anchor="first"/>
        </action>
        <group id="Pebble.Tools" text="Pebble" popup="true" icon="/icons/pebble.svg">
            <action
                id="Pebble.CheckEnvironment"
                class="com.github.dtretyakov.pebble.ui.CheckEnvironmentAction"
                text="Check Environment"
                description="Shows whether pebble-tool, an SDK and its toolchain are installed"/>
            <action
                id="Pebble.CaptureAllPlatforms"
                class="com.github.dtretyakov.pebble.emulator.CaptureAllPlatformsAction"
                text="Capture Every Platform"
                description="Screenshots of the app on every platform it targets, side by side"/>
            <action
                id="Pebble.TakeScreenshot"
                class="com.github.dtretyakov.pebble.ui.TakeScreenshotAction"
                text="Take Screenshot"
                description="Saves a screenshot from the watch or emulator the selected run configuration installs on"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
